\par \hich\af37\dbch\af31505\loch\f37   <meta ch\hich\af37\dbch\af31505\loch\f37 arset="UTF-8" />
\par \hich\af37\dbch\af31505\loch\f37   <title>Append Object & Check Array</title>
\par \hich\af37\dbch\af31505\loch\f37 </head>
\par \hich\af37\dbch\af31505\loch\f37 <body>
\par \hich\af37\dbch\af31505\loch\f37   <h2>Append Object to Array and Check if Object is an Array</h2>
\par 
\par \hich\af37\dbch\af31505\loch\f37   <div id="output"></div>
\par 
\par \hich\af37\dbch\af31505\loch\f37   <script>
\par \hich\af37\dbch\af31505\loch\f37     // Initialize empty array
\par \hich\af37\dbch\af31505\loch\f37     let arr = [];
\par 
\par \hich\af37\dbch\af31505\loch\f37     // Define an object
\par \hich\af37\dbch\af31505\loch\f37     let obj = \{ name: "Alice", age: 25 \};
\par 
\par \hich\af37\dbch\af31505\loch\f37     // Append object to array
\par \hich\af37\dbch\af31505\loch\f37     arr.push(obj);
\par 
\par \hich\af37\dbch\af31505\loch\f37     // Display array after appending
\par \hich\af37\dbch\af31505\loch\f37     const output = document.getElementById('output');
\par \hich\af37\dbch\af31505\loch\f37     output.innerHTML += `<p>Array after appending object: <pre>$\{JSON.str\hich\af37\dbch\af31505\loch\f37 ingify(arr, null, 2)\}</pre></p>`;
\par 
\par \hich\af37\dbch\af31505\loch\f37     // Function to check if input is array
\par \hich\af37\dbch\af31505\loch\f37     function checkIfArray(input) \{
\par \hich\af37\dbch\af31505\loch\f37       if (Array.isArray(input)) \{
\par \hich\af37\dbch\af31505\loch\f37         output.innerHTML += `<p>The input <code>$\{JSON.stringify(input)\}\hich\af37\dbch\af31505\loch\f37 </code> is an array.</p>`;
\par \hich\af37\dbch\af31505\loch\f37       \} else \{
\par \hich\af37\dbch\af31505\loch\f37         output.innerHTML += `<p>The input <code>$\{JSON.stringify(input)\}</code> is NOT an array.</p>`;
\par \hich\af37\dbch\af31505\loch\f37       \}
\par \hich\af37\dbch\af31505\loch\f37     \}
\par 
\par \hich\af37\dbch\af31505\loch\f37     // Test checks
\par \hich\af37\dbch\af31505\loch\f37     checkIfArray(arr);     // Array
\par \hich\af37\dbch\af31505\loch\f37     checkIfArray(obj);     // Object
\par \hich\af37\dbch\af31505\loch\f37     checkIfArray("hello"); // String
\par \hich\af37\dbch\af31505\loch\f37     checkIfArray([1, 2]);  // Array
\par \hich\af37\dbch\af31505\loch\f37   </script>
